# Copy to functions/.env and fill in. The Firebase Functions emulator auto-loads functions/.env.
# functions/.env is gitignored — never commit real keys.

# --- Plaid (bank sync) — sandbox from https://dashboard.plaid.com ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Gemini (categorization + Coach) — key from https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash if unset
GEMINI_MODEL=gemini-2.5-flash
