rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // bankConnections/** intentionally has NO match block: denied to all clients.
    // Only the Functions admin SDK (which bypasses rules) may read/write access tokens.

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
