rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // bankConnections/** intentionally has NO match block: denied to all clients.
    // Only the Functions admin SDK (which bypasses rules) may read/write access tokens.

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // `premium` is server-authoritative: only the Stripe webhook (admin SDK, which
      // bypasses rules) may set it. The client may create/update its own user doc but
      // must NEVER write a `premium` field — this blocks a client self-granting premium.
      // Guards both create (resource == null) and update paths.
      allow create: if request.auth != null && request.auth.uid == uid
        && !("premium" in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['premium']);
      allow delete: if request.auth != null && request.auth.uid == uid;
      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Per-user merchant→bucket categorization rules. The client writes these on
    // recategorize; the Functions admin SDK reads them during sync (bypasses rules).
    match /categoryRules/{uid}/{sub=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
